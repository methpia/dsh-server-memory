{
  "name": "dsh-server-memory",
  "version": "0.1.0",
  "description": "Project-scoped long-term memory for DeepSeek Harness: a compact prompt index, search/save/forget tools, and a once-a-day consolidation loop backed by a self-hosted memoryd service (Python stdlib, zero dependencies).",
  "type": "module",
  "license": "MIT",
  "author": "dsh-memory contributors",
  "homepage": "https://github.com/methpia/dsh-server-memory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/methpia/dsh-server-memory.git"
  },
  "bugs": {
    "url": "https://github.com/methpia/dsh-server-memory/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "self-hosted",
    "sqlite"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "config.example.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --experimental-test-isolation=none \"tests/*.test.js\"",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
