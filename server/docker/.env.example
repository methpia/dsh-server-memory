# Copy to .env and adjust.
#
# Interface to publish on:
#   127.0.0.1   local only (put a proxy or `tailscale serve` in front)
#   0.0.0.0     all interfaces (only with TLS or behind a firewall)
#   192.168.x.x a single LAN interface
BIND_ADDR=127.0.0.1

# Optional overrides. Defaults are ~/.config/dsh-memory and ~/dsh-memory/data.
# CONFIG_DIR=/Users/you/.config/dsh-memory
# DATA_DIR=/Users/you/dsh-memory/data
